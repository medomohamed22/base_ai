# Public config for the web app (all NEXT_PUBLIC_* values end up in the browser — no secrets here).
NEXT_PUBLIC_CHAIN=base-sepolia            # base | base-sepolia
NEXT_PUBLIC_EXECUTOR_ADDRESS=             # SahmExecutor on NEXT_PUBLIC_CHAIN; signing is disabled while empty
NEXT_PUBLIC_BASE_RPC_URL=                 # optional, defaults to the public RPC
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=         # optional
NEXT_PUBLIC_ONCHAINKIT_API_KEY=           # optional, CDP client key
