# ── Public (end up in the browser; no secrets) ──
NEXT_PUBLIC_CHAIN=base-sepolia            # base | base-sepolia (default)
NEXT_PUBLIC_EXECUTOR_ADDRESS=             # optional override; known deployments are in lib/chain.ts
NEXT_PUBLIC_BASE_RPC_URL=                 # optional
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=         # optional

# ── Server only (Vercel → Settings → Environment Variables; never commit values) ──
MODEL_API_KEY=                            # Meta Model API key (dev.meta.ai)
META_MODEL=                               # optional, default muse-spark-1.3-contributor
META_BASE_URL=                            # optional, default https://api.meta.ai/v1
SAHM_DB_SECRET=                           # same value as sahm_config.api_secret in Supabase (≥32 chars)
AGENT_PRIVATE_KEY=                        # agent wallet created on /deploy; the contract must trust it (setAgent)
CRON_SECRET=                              # optional; required header for /api/agent/tick when set
SUPABASE_URL=                             # optional, default is the Sahm project
SUPABASE_PUBLISHABLE_KEY=                 # optional, default is the Sahm project's public key
BASE_SEPOLIA_RPC_URL=                     # optional server RPC (e.g. Alchemy)
