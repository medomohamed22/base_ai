# ── Public (end up in the browser; no secrets) ──
NEXT_PUBLIC_CHAIN=base-sepolia            # base | base-sepolia (default)
NEXT_PUBLIC_EXECUTOR_ADDRESS=             # optional override; known deployments are in lib/chain.ts
NEXT_PUBLIC_BASE_RPC_URL=                 # optional
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=         # optional
NEXT_PUBLIC_ONCHAINKIT_API_KEY=           # optional, CDP client key

# ── Server only (set in Vercel → Settings → Environment Variables; never commit values) ──
SUPABASE_URL=https://cguxdschojoqbffdrlhm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                # Supabase → Project settings → API keys (secret / service_role)
AGENT_PRIVATE_KEY=                        # agent wallet created on /deploy; the contract must trust it (setAgent)
CRON_SECRET=                              # any long random string; also used in the pg_cron job
LLAMA_API_KEY=                            # Meta Llama API key
LLAMA_MODEL=                              # exact model id from the Llama API console
LLAMA_BASE_URL=                           # optional, default https://api.llama.com/compat/v1
BASE_SEPOLIA_RPC_URL=                     # optional server RPC (e.g. Alchemy)
